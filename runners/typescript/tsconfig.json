{
    "compilerOptions": {
        "target":                       "ES2023",
        "module":                       "ESNext",
        "moduleResolution":             "Bundler",
        "strict":                       true,
        "verbatimModuleSyntax":         true,
        "allowImportingTsExtensions":   true,
        "noEmit":                       true,
        "skipLibCheck":                 true
    },
    "include": ["runner.ts"]
}
