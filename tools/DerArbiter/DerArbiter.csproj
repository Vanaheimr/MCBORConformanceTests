<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    No ProjectReference, and that is the point of this project: the reader it
    uses must be neither of the two under test. System.Formats.Asn1 comes with
    the framework, so this project references nothing at all.
  -->

</Project>
